# Copy to dashboard/chat/.env and set a strong CHAT_TOKEN.
# dashboard/chat/.env is gitignored — never commit real secrets.
#
# Security: with CHAT_PERMISSION_MODE=bypassPermissions the token is
# shell-equivalent for the chat-service OS user. Keep CHAT_HOST=127.0.0.1.

CHAT_HOST=127.0.0.1
CHAT_PORT=8091
CHAT_TOKEN=change-me
CHAT_DEFAULT_MODEL=grok-4.5
CHAT_PERMISSION_MODE=bypassPermissions
CHAT_ROOT_PATH=/chat
CHAT_MODEL_ROUTER_URL=http://127.0.0.1:8088
ANTHROPIC_BASE_URL=http://127.0.0.1:8088
MODELS_CACHE_TTL_SEC=45.0

# Composer Image mode → grok2api (lite text-to-image)
CHAT_GROK2API_URL=http://127.0.0.1:8000
CHAT_IMAGE_MODEL=grok-imagine-image-lite
# CHAT_GROK2API_API_KEY=
CHAT_IMAGE_TIMEOUT_SEC=120
CHAT_IMAGE_N=1
# CHAT_GENERATED_IMAGES_DIR=...  # default: dashboard/chat/data/generated-images

# Dashboard proxy (set when starting dashboard/server.py, not required in this file):
# CHAT_UPSTREAM=http://127.0.0.1:8091
# CHAT_PROXY_TIMEOUT=3600
# DASHBOARD_HOST=127.0.0.1
# DASHBOARD_PORT=8090
